<%- include('../header') %>
<%- include('../navbar') %>

<div class="container-fluid">
    <div class="row">
        <%- include('sidebar') %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            <h3 class="fw-bold mb-4">QUẢN LÝ ĐÁNH GIÁ</h3>
            
            <div class="table-responsive bg-white shadow-sm rounded p-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Người dùng</th>
                            <th class="text-center">Đánh giá</th>
                            <th>Nội dung bình luận</th>
                            <th>Ngày đăng</th>
                            <th class="text-center">Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (dsDanhGia && dsDanhGia.length > 0) { %>
                            <% dsDanhGia.forEach(dg => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="/images/<%= dg.Sach_id ? dg.Sach_id.HinhAnh : 'default.jpg' %>" 
                                             class="me-2 rounded" style="width: 40px; height: 55px; object-fit: cover;">
                                        <span class="fw-bold small text-primary">
                                            <%= dg.Sach_id ? dg.Sach_id.TenSach : 'Sách đã xóa' %>
                                        </span>
                                    </div>
                                </td>
                                <td class="small"><%= dg.User_id ? dg.User_id.HoVaTen : 'Ẩn danh' %></td>
                                <td class="text-center text-warning">
                                    <%= dg.SoSao %> <i class="bi bi-star-fill"></i>
                                </td>
                                <td class="small" style="max-width: 200px;"><%= dg.NoiDung %></td>
                                <td class="text-muted small">
                                    <%= dg.createdAt.toLocaleDateString('vi-VN') %>
                                </td>
                                <td class="text-center">
                                    <form action="/admin/xoa-danh-gia/<%= dg._id %>?_method=DELETE" method="POST" 
                                          onsubmit="return confirm('Xóa đánh giá này?')">
                                        <button type="submit" class="btn btn-link text-danger p-0">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Chưa có đánh giá nào.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<%- include('../footer') %>