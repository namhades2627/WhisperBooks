<%- include('../header') %>
<%- include('../navbar') %>

<div class="container-fluid">
    <div class="row">
        <%- include('sidebar') %>
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light">
            <h2 class="fw-bold text-uppercase mb-4">Thống kê doanh thu</h2>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-primary text-white h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-uppercase mb-2 opacity-75">Tổng doanh thu</h6>
                                    <h3 class="fw-bold mb-0"><%= tongDoanhThu.toLocaleString() %>đ</h3>
                                </div>
                                <div class="fs-1 opacity-50">
                                    <i class="bi bi-currency-dollar"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-success text-white h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-uppercase mb-2 opacity-75">Doanh thu hôm nay</h6>
                                    <h3 class="fw-bold mb-0"><%= doanhThuHomNay.toLocaleString() %>đ</h3>
                                </div>
                                <div class="fs-1 opacity-50">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-uppercase mb-2 opacity-75">Đơn hàng mới</h6>
                                    <h3 class="fw-bold mb-0"><%= soDonMoi %></h3>
                                </div>
                                <div class="fs-1 opacity-50">
                                    <i class="bi bi-cart-plus"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            </main>
    </div>
</div>