<%- include('../header') %>
<%- include('../navbar') %>

<div class="container-fluid">
    <div class="row">
        <%- include('sidebar') %>
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light">
            <h2 class="fw-bold text-uppercase mb-4">Quản lý Đơn hàng</h2>
            
            <div class="table-responsive bg-white shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Khách hàng / SĐT</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dsDonHang.forEach(dh => { %>
                        <tr>
                            <td>
                                <div class="fw-bold"><%= dh.HoVaTen %></div>
                                <small class="text-muted"><%= dh.SoDienThoai %></small>
                            </td>
                            <td><%= new Date(dh.NgayDat).toLocaleDateString('vi-VN') %></td>
                            <td class="text-danger fw-bold"><%= dh.TongTien.toLocaleString() %>đ</td>
                            <td>
                                <% if (dh.TrangThai === 0) { %>
                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                <% } else if (dh.TrangThai === 1) { %>
                                    <span class="badge bg-info text-white">Đang giao</span>
                                <% } else if (dh.TrangThai === 2) { %>
                                    <span class="badge bg-success text-white">Hoàn thành</span>
                                <% } else if (dh.TrangThai === 3) { %>
                                    <span class="badge bg-danger text-white">Đã hủy</span>
                                <% } %>
                            </td>
                            <td class="text-end pe-3">
                                <a href="/admin/don-hang/chi-tiet/<%= dh._id %>" class="btn btn-sm btn-info text-white">
                                    <i class="bi bi-eye"></i> Xem chi tiết
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>