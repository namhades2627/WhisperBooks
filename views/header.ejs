<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Whisper Books</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/CSS/app.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cart.js"></script>
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
            CKEDITOR.config.versionCheck = false;
    </script>
</head>
<body>
    <header class="py-3 border-bottom bg-white sticky-top shadow-sm">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <a href="/" class="text-decoration-none">
                        <h3 class="text-primary fw-bold mb-0">WHISPER BOOKS</h3>
                    </a>
                </div>

                <div class="col-md-6">
                    <form action="/tim-kiem" method="GET" class="d-flex w-100">
                        <input type="text" name="search" class="form-control" placeholder="Tìm cuốn sách bạn yêu thích...">
                        <button type="submit" class="btn btn-primary ms-2">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <div class="col-md-3 text-end d-flex align-items-center justify-content-end">
                    <div class="dropdown profile-dropdown me-3">
    <a href="#" class="text-dark d-flex align-items-center justify-content-center text-decoration-none" id="profileMenu" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-person fs-4"></i>
    </a>
    
    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-3 animate-fade-in" aria-labelledby="profileMenu">
        <% if (user) { %>
            <li>
                <div class="dropdown-item-text border-bottom pb-2 mb-2 bg-light rounded-top">
                    <small class="text-muted d-block">Xin chào,</small>
                    <span class="fw-bold text-primary"><%= user.HoTen %></span>
                </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item py-2 text-danger fw-bold" href="/dangxuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
        <% } else { %>
            <li><a class="dropdown-item py-2" href="/dangnhap"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</a></li>
            <li><a class="dropdown-item py-2" href="/dangky"><i class="bi bi-pencil-square me-2"></i>Đăng ký</a></li>
        <% } %>
    </ul>
</div>
                    
                    <a href="javascript:void(0)" 
                       class="text-dark position-relative text-decoration-none" 
                       data-bs-toggle="offcanvas" 
                       data-bs-target="#sideCart">
                        <i class="bi bi-cart fs-4"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartBadge">
                            0
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="sideCart" aria-labelledby="sideCartLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold" id="sideCartLabel">GIỎ HÀNG CỦA BẠN</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div id="cartContent">
                <div class="text-center py-5">
                    <i class="bi bi-cart-x fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">Giỏ hàng đang trống</p>
                </div>
            </div>
        </div>
        <div class="cart-footer">
            <div class="d-flex justify-content-between mb-3 fw-bold">
                <span>TỔNG TIỀN:</span>
                <span class="text-danger fs-5">0đ</span>
            </div>
            <div class="d-grid gap-2">
                <button class="btn btn-primary py-2 fw-bold w-100" onclick="proceedToCheckout('cart')">THANH TOÁN</button>
            </div>
        </div>
    </div>