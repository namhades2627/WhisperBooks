<%- include('header') %>
<%- include('navbar') %>

<main class="container mt-5 mb-5">
    <div class="row bg-white p-4 shadow-sm rounded">
        <div class="col-md-5 text-center">
            <img src="/images/<%= s.HinhAnh %>" class="img-fluid rounded shadow" style="max-height: 500px;" alt="<%= s.TenSach %>">
        </div>

        <div class="col-md-7">
            <h2 class="fw-bold mb-3"><%= s.TenSach %></h2>
            
            <div class="d-flex align-items-center mb-3">
                <span class="text-danger fs-3 fw-bold me-3"><%= s.GiaBan.toLocaleString() %>đ</span>
            </div>

            <div class="mb-4 p-3 bg-light rounded">
                <p class="mb-2"><strong>Nhà cung cấp:</strong> <span class="text-primary"><%= s.NhaCungCap %></span></p>
                <p class="mb-0"><strong>Thể loại:</strong> <span class="text-primary"><%= s.TheLoai ? s.TheLoai.TenTheLoai : 'Đang cập nhật' %></span></p>
            </div>

            <p class="text-muted mb-4">
                <strong>Tình trạng:</strong> 
                <%- s.SoLuong > 0 
                    ? '<span class="text-success">Còn hàng</span>' 
                    : '<span class="text-danger">Hết hàng</span>' 
                %>
            </p>

            <div class="d-flex align-items-center mb-4">
                <span class="me-3 fw-bold">SỐ LƯỢNG:</span>
                <div class="input-group" style="width: 130px;">
                    <button class="btn btn-outline-secondary px-3" type="button" onclick="changeQty(-1)">-</button>
                    <input type="text" id="soluong" class="form-control text-center bg-white" value="1" readonly>
                    <button class="btn btn-outline-secondary px-3" type="button" onclick="changeQty(1)">+</button>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-start mt-4">
                <% if (user) { %>
                    <button onclick="handleAddToCart()" class="btn btn-outline-primary btn-lg px-4 fw-bold">
                        <i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ
                    </button>
                    <button onclick="handleBuyNow()" class="btn btn-danger btn-lg px-4 fw-bold">
                        Mua ngay
                    </button>
                <% } else { %>
                    <button onclick="alertLogin()" class="btn btn-outline-primary btn-lg px-4 fw-bold">
                        <i class="bi bi-cart-plus me-2"></i>Thêm vào giỏ
                    </button>
                    <button onclick="alertLogin()" class="btn btn-danger btn-lg px-4 fw-bold">
                        Mua ngay
                    </button>
                <% } %>
            </div>
    
            <div class="border-top pt-4 mt-4">
                <h5 class="fw-bold">Mô tả sách</h5>
                <div class="text-justify mt-2 text-muted">
                    <%- s.MoTa %>
                </div>
            </div>

            <div class="mt-4 border-top pt-3">
                <% if (user) { %>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                        <i class="bi bi-pencil"></i> Viết đánh giá
                    </button>
                <% } else { %>
                    <button onclick="alertLogin()" class="btn btn-outline-secondary">
                        <i class="bi bi-pencil"></i> Đăng nhập để đánh giá
                    </button>
                <% } %>
            </div>
        </div> 
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h4 class="fw-bold border-bottom pb-2 text-uppercase">Đánh giá từ khách hàng</h4>
            <div class="mt-3">
                <% if (typeof dsDanhGia !== 'undefined' && dsDanhGia.length > 0) { %>
                    <% dsDanhGia.forEach(dg => { %>
                        <div class="card mb-3 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0 text-primary"><%= dg.User_id ? dg.User_id.HoVaTen : 'Người dùng ẩn danh' %></h6>
                                    <small class="text-muted"><%= dg.createdAt.toLocaleDateString('vi-VN') %></small>
                                </div>
                                <div class="text-warning mb-2">
                                    <% for(let i=0; i < dg.SoSao; i++) { %>
                                        <i class="bi bi-star-fill"></i>
                                    <% } %>
                                    <% for(let i=dg.SoSao; i < 5; i++) { %>
                                        <i class="bi bi-star"></i>
                                    <% } %>
                                </div>
                                <p class="card-text"><%= dg.NoiDung %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-4 bg-light rounded">
                        <p class="text-muted mb-0">Chưa có đánh giá nào cho cuốn sách này. Hãy là người đầu tiên!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="modalDanhGia" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="/sach/danh-gia" method="POST">
                <div class="modal-header border-0">
                    <h5 class="modal-title w-100 text-center fw-bold">VIẾT ĐÁNH GIÁ SẢN PHẨM</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="rating-stars mb-3 fs-3 text-warning">
                        <i class="bi bi-star star-item" data-value="1" style="cursor:pointer"></i>
                        <i class="bi bi-star star-item" data-value="2" style="cursor:pointer"></i>
                        <i class="bi bi-star star-item" data-value="3" style="cursor:pointer"></i>
                        <i class="bi bi-star star-item" data-value="4" style="cursor:pointer"></i>
                        <i class="bi bi-star star-item" data-value="5" style="cursor:pointer"></i>
                        <input type="hidden" name="SoSao" id="inputSoSao" value="5">
                        <input type="hidden" name="Sach_id" value="<%= s._id %>">
                    </div>
                    <textarea name="NoiDung" class="form-control" rows="4" placeholder="Nhập nhận xét của bạn" required></textarea>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger px-5">Gửi nhận xét</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('footer') %>

<script>
    function changeQty(amt) {
        var qtyInput = document.getElementById('soluong');
        var currentQty = parseInt(qtyInput.value);
        var newQty = currentQty + amt;
        var maxQty = parseInt('<%= s.SoLuong %>'); 
        if (newQty > 0 && newQty <= maxQty) {
            qtyInput.value = newQty;
        }
    }

    const bookData = <%- JSON.stringify({
        id: String(s._id),
        ten: s.TenSach,
        gia: s.GiaBan,
        hinh: s.HinhAnh || ''
    }).replace(/</g, '\\u003c') %>;

    function getProductData() {
        return {
            ...bookData,
            quantity: parseInt(document.getElementById('soluong').value)
        };
    }

    function handleAddToCart() {
        var p = getProductData();
        if (typeof addToCart === "function") {
            addToCart(p.id, p.ten, p.gia, p.hinh, p.quantity);
        } else {
            alert("Lỗi: Không tìm thấy chức năng giỏ hàng!");
        }
    }

    function handleBuyNow() {
        var p = getProductData();
        if (typeof proceedToCheckout === "function") {
            proceedToCheckout('single', p);
        } else {
            alert("Lỗi: Không tìm thấy chức năng thanh toán!");
        }
    }
    
    function alertLogin() {
        alert("Vui lòng đăng nhập để thực hiện chức năng này!");
        window.location.href = '/dangnhap';
    }

    document.querySelectorAll('.star-item').forEach(star => {
        star.addEventListener('click', function() {
            let val = this.getAttribute('data-value');
            document.getElementById('inputSoSao').value = val;
            document.querySelectorAll('.star-item').forEach(s => {
                s.classList.replace('bi-star-fill', 'bi-star');
            });
            for(let i=0; i<val; i++) {
                document.querySelectorAll('.star-item')[i].classList.replace('bi-star', 'bi-star-fill');
            }
        });
    });
</script>