<%- include('header') %>
<%- include('navbar') %>

<div class="container main-content shadow-sm p-4">
    <h4 class="fw-bold text-dark mb-4"><i class="bi bi-person-badge"></i> SÁCH TÔI QUẢN LÝ</h4>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sách</th>
                    <th>Giá bán</th>
                    <th>Ngày nhập</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% sach.forEach(item => { %>
                <tr>
                    <td><img src="<%= item.HinhAnh %>" width="50" class="rounded shadow-sm"></td>
                    <td><span class="fw-bold"><%= item.TenSach %></span></td>
                    <td class="text-danger fw-bold"><%= item.GiaBan.toLocaleString('vi-VN') %>đ</td>
                    <td class="small"><%= new Date(item.NgayNhap).toLocaleDateString('vi-VN') %></td>
                    <td>
                        <% if(item.KiemDuyet == 1) { %>
                            <span class="badge bg-success-subtle text-success border border-success">Đã duyệt</span>
                        <% } else { %>
                            <span class="badge bg-warning-subtle text-warning border border-warning">Chờ duyệt</span>
                        <% } %>
                    </td>
                    <td class="text-end">
                        <a href="/sach/sua/<%= item._id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form action="/sach/xoa/<%= item._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sách này?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('footer') %>
<%- include('javascript') %>