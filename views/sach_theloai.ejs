<%- include('header') %>
<%- include('navbar') %>

<div class="container mt-4">
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
			<li class="breadcrumb-item active" aria-current="page">Thể loại</li>
			<li class="breadcrumb-item active" aria-current="page"><%= title %></li>
		</ol>
	</nav>

	<h3 class="fw-bold mb-4">Chủ đề: <span class="text-primary"><%= title %></span></h3>

	<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
		<% if(sach.length > 0) { %>
			<% sach.forEach(function(item) { %>
				<div class="col">
					<div class="book-card shadow-sm border-0 h-100 card">
						<div class="book-img-container" style="height: 250px; overflow: hidden; background: #f0f0f0;">
							<a href="/sach/chitiet/<%= item._id %>">
								<img src="<%= item.HinhAnh %>" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="<%= item.TenSach %>">
							</a>
						</div>
						<div class="card-body d-flex flex-column">
							<a href="/sach/chitiet/<%= item._id %>" class="text-decoration-none">
								<h6 class="card-title text-dark fw-bold text-truncate"><%= item.TenSach %></h6>
							</a>
							<p class="small text-muted mb-2"><%= item.TacGia %></p>
							<div class="mt-auto d-flex justify-content-between align-items-center">
								<span class="text-danger fw-bold"><%= item.GiaBan.toLocaleString('vi-VN') %>đ</span>
								<button class="btn btn-sm btn-outline-primary"><i class="bi bi-cart-plus"></i></button>
							</div>
						</div>
					</div>
				</div>
			<% }); %>
		<% } else { %>
			<div class="col-12 text-center py-5">
				<div class="opacity-50">
					<i class="bi bi-folder2-open display-1"></i>
					<p class="mt-3 fs-5">Chưa có sách nào trong thể loại này.</p>
				</div>
				<a href="/" class="btn btn-primary mt-2">Quay lại trang chủ</a>
			</div>
		<% } %>
	</div>
</div>

<%- include('footer') %>
<%- include('javascript') %>