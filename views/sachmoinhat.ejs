<%- include('header') %>
<%- include('navbar') %>

<div class="container mt-4">
	<h3 class="fw-bold mb-4 border-start border-4 border-primary ps-3">
		<%= title %> </h3>

	<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
		<% if(sach.length > 0) { %>
			<% sach.forEach(function(item) { %>
				<div class="col">
					<div class="book-card shadow-sm border-0 h-100">
						<div class="book-img-container">
							<a href="/sach/chitiet/<%= item._id %>">
								<img src="<%= item.HinhAnh %>" alt="<%= item.TenSach %>">
							</a>
						</div>
						<div class="book-content p-3">
							<a href="/sach/chitiet/<%= item._id %>" class="text-decoration-none">
								<h6 class="book-title text-dark"><%= item.TenSach %></h6>
							</a>
							<p class="book-author"><%= item.TacGia %></p>
							<div class="d-flex justify-content-between align-items-center mt-auto">
								<span class="book-price"><%= item.GiaBan.toLocaleString('vi-VN') %>đ</span>
								<button class="btn btn-sm btn-outline-primary"><i class="bi bi-cart-plus"></i></button>
							</div>
						</div>
					</div>
				</div>
			<% }); %>
		<% } else { %>
			<div class="col-12 text-center py-5">
				<i class="bi bi-search fs-1 text-muted"></i>
				<p class="mt-3">Không tìm thấy quyển sách nào phù hợp.</p>
			</div>
		<% } %>
	</div>
</div>

<%- include('footer') %>
<%- include('javascript') %>