<%- include('header') %>
<%- include('navbar') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> CẬP NHẬT THỂ LOẠI</h5>
                </div>
                <div class="card-body p-4">
                    <form action="/theloai/sua/<%= theloai._id %>" method="post" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Tên thể loại hiện tại</label>
                            <input type="text" name="TenTheLoai" class="form-control" value="<%= theloai.TenTheLoai %>" required>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a href="/theloai" class="btn btn-light border">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
<%- include('javascript') %>